{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Qore immutable resource inventory",
  "required": [
    "schema",
    "version",
    "host",
    "redistribution",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "qore-release/1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "const": "codex"
    },
    "redistribution": {
      "const": "MIT-first-party"
    },
    "kind": {
      "enum": [
        "generic",
        "derived"
      ]
    },
    "profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "origin",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "first-party",
              "Qaizen-public-observation"
            ]
          },
          "license": {
            "const": "MIT"
          }
        }
      }
    }
  }
}
