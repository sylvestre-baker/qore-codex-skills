122: def build(output):
123:     allowlist = read_json(ROOT / "release-files.json")
124:     if not isinstance(allowlist, list) or not allowlist or len(allowlist) != len(set(allowlist)):
125:         raise ValueError("release-files.json must be an explicit unique list")
126:     selected = [contained(ROOT, name) for name in allowlist]
127:     if any(p.is_symlink() for p in selected):
128:         raise ValueError("Allowlisted files may not be symlinks")
129:     check_redistribution(ROOT, allowlist)
130:     output.mkdir(parents=True, exist_ok=True)
131:     destination = output / ("qore-skills-" + VERSION)
132:     archive = output / (destination.name + ".zip")
133:     if destination.exists() or archive.exists():
134:         raise ValueError("Release destination exists; choose new staging")
135:     temporary = Path(tempfile.mkdtemp(prefix=".qore-build-", dir=output))
136:     try:
137:         tree = temporary / destination.name
138:         tree.mkdir()
139:         for relative, source in zip(allowlist, selected):
140:             target = tree / relative
141:             target.parent.mkdir(parents=True, exist_ok=True)
142:             shutil.copyfile(source, target)
143:         check_references(tree)
144:         finalize(tree, "generic")
145:         verify(tree)
146:         zip_path = temporary / archive.name
147:         with zipfile.ZipFile(zip_path, "w", compression=zipfile.ZIP_DEFLATED) as z:
148:             for path in files_under(tree):
149:                 item = zipfile.ZipInfo(str(Path(tree.name) / path.relative_to(tree)), date_time=(2026, 10, 15, 0, 0, 0))
150:                 item.create_system = 3
151:                 item.external_attr = 0o100644 << 16
152:                 item.compress_type = zipfile.ZIP_DEFLATED
153:                 z.writestr(item, path.read_bytes())
154:         tree.rename(destination)
155:         zip_path.rename(archive)
156:     finally:
157:         shutil.rmtree(temporary)
158:     return {"bundle": str(destination), "archive": str(archive), "sha256": digest(archive), **verify(destination)}
