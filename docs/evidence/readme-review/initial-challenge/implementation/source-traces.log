161: def check_redistribution(root, allowlist):
162:     """Check explicit maintainer attestations, not infer rights from file contents."""
163:     packet = read_json(root / "release-rights.json")
164:     if not isinstance(packet, dict) or packet.get("schema") != "qore-rights/1":
165:         raise ValueError("Expected explicit redistribution record qore-rights/1")
166:     records = packet.get("resources")
167:     if not isinstance(records, list):
168:         raise ValueError("Redistribution resources must be a list")
169:     expected = set(allowlist) - {"release-rights.json", "release-files.json"}
170:     seen = set()
171:     for record in records:
172:         if not isinstance(record, dict) or record.get("path") not in expected or record["path"] in seen:
173:             raise ValueError("Unexpected or duplicate redistribution resource: " + str(record.get("path") if isinstance(record, dict) else record))
174:         name = record["path"]
175:         seen.add(name)
176:         if record.get("status") != "approved" or record.get("license") != "MIT" or record.get("origin") not in ("first-party", "Qaizen-public-observation") or not record.get("basis"):
177:             raise ValueError("Unknown or unauthorized redistribution right: " + name)
178:         if digest(contained(root, name)) != record.get("sha256"):
179:             raise ValueError("Redistribution review is stale: " + name)
180:     if expected != seen:
181:         raise ValueError("Missing redistribution review: " + ", ".join(sorted(expected - seen)))
182:     return {"valid": True, "resources": len(seen), "limit": "Maintainer attestations require truthful rights review; hashes do not determine ownership."}
185: def derive(profile_path, project_root, output):
186:     profile = read_json(profile_path)
187:     for method in METHODS.values():
188:         result = validate_profile(profile, project_root, method)
189:         if result["coverage"] != "COMPLETE":
190:             raise ValueError("Profile is not current for " + method + ": " + "; ".join(result["problems"]))
191:     if output.exists():
192:         raise ValueError("Derived destination exists; choose new staging")
193:     profile_info = {"id": profile["id"], "version": profile["version"], "sha256": digest(profile_path)}
194:     output.parent.mkdir(parents=True, exist_ok=True)
195:     temporary = Path(tempfile.mkdtemp(prefix=".qore-derive-", dir=output.parent))
196:     tree = temporary / "candidate"
197:     tree.mkdir()
198:     try:
199:         for name in SKILLS:
200:             derived = name + "-" + profile["id"]
201:             target = tree / derived
202:             shutil.copytree(ROOT / "skills" / name, target, symlinks=True)
203:             for path in files_under(target):
204:                 if path.suffix in (".md", ".yaml"):
205:                     text = path.read_text(encoding="utf-8").replace("$" + name, "$" + derived)
206:                     if path.name == "SKILL.md":
207:                         text = re.sub(r"(?m)^name:.*$", "name: " + derived, text, count=1)
208:                         text += ("\n## Generated project binding\n\nThis derivative must load [its project profile](references/project.json) before selecting project facts. "
209:                                  "Run its bundled project-check.py against the supplied project root with --method " + METHODS[name] +
210:                                  ". Consume only current returned facts; stale required context is PARTIAL or BLOCKED. "
211:                                  "The profile grants no action permission. Edit the maintained profile, not this generated copy.\n")
212:                     path.write_text(text, encoding="utf-8")
213:             write_json(target / "references/project.json", profile)
214:         finalize(tree, "derived", profile_info)
215:         verify(tree)
216:         tree.rename(output)
217:     finally:
218:         shutil.rmtree(temporary)
219:     return {"output": str(output), "profile": profile_info, **verify(output)}

